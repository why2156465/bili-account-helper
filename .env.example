# 复制成 .env 后按需修改；本文件仅示例，不要提交真实密钥
SECRET_KEY=change-me-to-a-48-bytes-random-string
DB_PATH=data/app.db
ADMIN_PATH=admin234
DEBUG=true
SITE_URL=http://127.0.0.1:8000

# 邮件：留空则验证码打印到控制台（[MAIL-DEV]）
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 33娘：留空则使用内置规则引擎
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

WORKER_ENABLED=true
WORKER_TICK=30

CAPTCHA_TTL=300
CODE_TTL=600
CODE_RESEND=60
LOGIN_MAX_FAIL=8
LOGIN_FAIL_WINDOW=900
